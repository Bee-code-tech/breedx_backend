PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/breedx

JWT_SECRET=your_jwt_secret_here

# Public address of this API (email images load from here)
API_URL=http://localhost:5000

# Frontends allowed to call the API with cookies (comma-separated)
CLIENT_ORIGINS=http://localhost:3000

RESEND_API_KEY=your_resend_api_key_here

# OAuth client ID from Google Auth Platform (the client secret is not needed)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Sender for OTP emails (domain must be verified in Resend)
MAIL_FROM=BreedX <info@breedx.org>
